{% extends "layouts/application" %}

{% block title %}
    Tabela de Clientes
{% endblock title %}

{% block content %}
    <div class="container mt-5">
        <h1>Novo Cliente</h1>
        <form action="/clients/{{ client.id }}/update" method="post">
            <div class="form-group">
                <label for="nome">Nome:</label>
                <input type="text" class="form-control" value="{{ client.name }}" id="name" name="name" placeholder="Digite o nome do cliente" required>
            </div>
            <div class="form-group">
                <label for="cpf">CPF:</label>
                <input type="text" class="form-control" value="{{ client.cpf }}" id="cpf" name="cpf" placeholder="Digite o CPF do cliente" required>
            </div>
            {% if error != "" %}
            <div class="alert alert-danger" role="alert">
                {{ error }}
            </div>
            {% endif %}
            <button type="submit" class="btn btn-primary">Salvar</button>
        </form>
    </div>
{% endblock content %}
